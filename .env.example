# Telegram bot token from @BotFather
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Whitelist: up to 2 Telegram user IDs (comma-separated)
ALLOWED_USER_IDS=YOUR_TELEGRAM_USER_ID

# Per-user defaults (override global WAKE_UP_TIME / INACTIVITY_HOURS)
# USER_123456789_WAKE_UP=07:00
# USER_123456789_INACTIVITY_HOURS=2

# Fallback defaults if USER_{id}_* not set
WAKE_UP_TIME=07:00
INACTIVITY_HOURS=2

# IANA timezone, e.g. Europe/Moscow, Europe/Berlin
TIMEZONE=Europe/Moscow

# Quiet hours: no inactivity reminders from SLEEP_TIME until WAKE_UP_TIME
SLEEP_TIME=23:00

# Optional: only if api.telegram.org is blocked on the host
# HTTPS_PROXY=http://127.0.0.1:1080

# Legacy (still supported for migration from single-user setup):
# ALLOWED_USER_ID=YOUR_TELEGRAM_USER_ID
